# Copy to keystore.properties (git-ignored) and fill in. Without this file the release build
# still works, but falls back to the debug signing key and Play will reject the upload.
#
# This must be the ORIGINAL upload key registered for com.krementransport — the 1.4.x releases
# were signed with it. If it has been lost, request an upload key reset in the Play Console
# rather than generating a new one and hoping.
storeFile=fastlane/private/upload.jks
storePassword=
keyAlias=
keyPassword=
