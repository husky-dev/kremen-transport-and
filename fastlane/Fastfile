default_platform(:android)
opt_out_usage

# Google Play service account, kept out of the repo. Create one under
# Play Console -> Users and permissions (or Google Cloud -> IAM -> Service accounts) with the
# "Release manager" role, download its JSON key and drop it at:
#
#   fastlane/private/play_key.json
#
# `fastlane/private/` is git-ignored. Verify the credentials with `fastlane run validate_play_store_json_key`.
#
# fastlane comes from Homebrew (`brew install fastlane`), so there is no Gemfile or bundler here,
# matching the iOS repo.
PLAY_KEY_PATH = File.expand_path("private/play_key.json", __dir__)

def play_key_path!
  UI.user_error!("Missing #{PLAY_KEY_PATH} — see the comment at the top of the Fastfile") unless File.exist?(PLAY_KEY_PATH)
  PLAY_KEY_PATH
end

# The AAB Play actually receives. `bundleRelease` reads keystore.properties for signing; without
# it Gradle falls back to the debug key, which Play will reject — deliberately, rather than
# uploading something unsigned by accident.
AAB_PATH = "app/build/outputs/bundle/release/app-release.aab"

platform :android do
  desc "Download the live Play listing into fastlane/metadata/android"
  lane :metadata_pull do
    # supply only exposes downloading through `init` on its CLI, not through an action.
    # Overwriting is safe — this is git, so the result reads as a diff.
    Dir.chdir("..") do
      sh("fastlane", "supply", "init", "--json_key", play_key_path!, "--track", "internal")
    end
  end

  desc "Upload fastlane/metadata/android back to Play (no binary, no images)"
  # A changelog belongs to a *release*, not to the listing: supply can only attach
  # metadata/android/<locale>/changelogs/<code>.txt to a version code Play already has. With no
  # binary in the edit it has no code to aim at and dies with
  # "Could not find release for version code '' to update changelog". So listing text goes up on
  # its own here, and the changelog rides along with the AAB in the `internal` lane. Pass
  # `version_code:` (and the track holding it) to push a changelog to an already-uploaded build:
  #   fastlane metadata_push version_code:1005000 track:internal
  lane :metadata_push do |options|
    version_code = options[:version_code]&.to_i
    supply(
      json_key: play_key_path!,
      track: options[:track] || "internal",
      version_code: version_code,
      skip_upload_changelogs: version_code.nil?,
      skip_upload_apk: true,
      skip_upload_aab: true,
      skip_upload_images: true,
      skip_upload_screenshots: true
    )
  end

  desc "Upload the listing images and screenshots in fastlane/metadata/android"
  lane :images_push do
    supply(
      json_key: play_key_path!,
      skip_upload_apk: true,
      skip_upload_aab: true,
      skip_upload_metadata: true,
      skip_upload_changelogs: true
    )
  end

  desc "Build a release AAB and upload it to the internal track"
  lane :internal do
    gradle(task: "bundle", build_type: "Release")
    supply(
      json_key: play_key_path!,
      track: "internal",
      aab: AAB_PATH,
      # A leftover app-release.apk from `make release` makes supply refuse the edit outright
      # ("Cannot provide both apk(s) and aab"), even though the AAB is named explicitly above.
      skip_upload_apk: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      release_status: "completed"
    )
  end

  desc "Promote the internal build to production. Rolls out to a fraction first."
  lane :production do |options|
    supply(
      json_key: play_key_path!,
      track: "internal",
      track_promote_to: "production",
      # A transport app people rely on daily: ramp rather than flip.
      rollout: options[:rollout] || "0.2",
      skip_upload_apk: true,
      skip_upload_aab: true,
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true
    )
  end
end
